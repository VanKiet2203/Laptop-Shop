# Sao chép file này thành .env rồi sửa cho đúng máy của bạn
PORT=3000
SESSION_SECRET=doi-chuoi-bi-mat-nay

# --- SQL Server (dùng đăng nhập SQL: bật Mixed Mode + tạo login, hoặc dùng 'sa') ---
DB_SERVER=localhost
DB_PORT=1433
# Nếu dùng named instance (vd SQLEXPRESS) thì điền DB_INSTANCE và để trống DB_PORT
DB_INSTANCE=
DB_NAME=LaptopShopDB
DB_USER=sa
DB_PASSWORD=YourStrong@Passw0rd
DB_ENCRYPT=false
DB_TRUST_CERT=true

# Địa chỉ website (dùng trong link ở email). Mặc định http://localhost:<PORT>
APP_URL=http://localhost:3000

# --- Đăng nhập bằng Google (tuỳ chọn) ---
# Tạo OAuth Client ID (Web application) tại https://console.cloud.google.com/apis/credentials
# và thêm "Authorized redirect URI" đúng bằng GOOGLE_CALLBACK_URL bên dưới.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# --- Gửi email xác nhận đơn hàng / gửi lại mã đơn (tuỳ chọn) ---
# Để trống SMTP_HOST thì email KHÔNG gửi thật mà được lưu thành file HTML trong thư mục outbox/ (dùng khi demo).
# Ví dụ Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=tai-khoan@gmail.com, SMTP_PASS=<mật khẩu ứng dụng 16 ký tự>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Laptop Shop" <no-reply@laptopshop.vn>

# --- Chat có trợ lý AI (Google Gemini - dùng được key MIỄN PHÍ) ---
# Lấy key tại https://aistudio.google.com/apikey . Key CHỈ đặt ở đây (phía server), không bao giờ gửi xuống trình duyệt, không commit lên git.
# Chưa điền thì chat vẫn chạy: AI được thay bằng bộ trả lời dự phòng theo từ khoá (chính sách shop + hotline).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Model dự phòng khi model chính bị ngừng/quá tải (alias luôn trỏ bản mới nhất còn hoạt động)
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
CHAT_AI_ENABLED=true
# Nhân viên chưa trả lời sau bấy nhiêu giây thì AI trả lời thay (nhân viên hoạt động trong 15 phút gần nhất thì AI giữ im lặng)
CHAT_AI_DELAY_SECONDS=45
CHAT_STAFF_ACTIVE_MINUTES=15
# Trần gọi Gemini để không vượt hạn mức miễn phí (~10 yêu cầu/phút, ~250/ngày với model flash)
CHAT_AI_MAX_PER_MINUTE=8
CHAT_AI_MAX_PER_DAY=200
CHAT_AI_MAX_REPLIES=30

# --- Vận hành / bảo mật ---
# development: hiện chi tiết lỗi trên trang 500. production: ẩn chi tiết, cookie Secure, BẮT BUỘC đặt SESSION_SECRET khác mặc định.
NODE_ENV=development
# Chạy sau proxy/nginx/Render (HTTPS do proxy lo): TRUST_PROXY=1
TRUST_PROXY=
# Phiên lưu trong SQL Server (bảng Sessions). Đặt memory nếu chưa chạy lại file 01_schema.sql mới.
SESSION_STORE=sql
# Đơn "Đang kiểm tra hàng" quá bấy nhiêu giờ chưa xác nhận thì tự huỷ để nhả hàng giữ chỗ.
# Để trống: BẬT 48 giờ khi NODE_ENV=production, TẮT khi phát triển (tránh làm mất đơn chờ mẫu trong DB demo). 0 = tắt hẳn.
PENDING_HOLD_HOURS=
# Ẩn hộp "tài khoản thử nghiệm" ở trang đăng nhập khi demo thật
SHOW_DEMO_ACCOUNTS=true
