<h1 class="page-title"><span class="page-title-ico"><%- ico('cart') %></span> Giỏ hàng <% if (items.length) { %><small class="text-muted fw-normal tabular-nums">(<span data-cart-count><%= items.reduce(function (s, i) { return s + i.Quantity; }, 0) %></span> sản phẩm)</small><% } %></h1>

<% if (!items.length) { %>
  <div class="empty-card">
    <%- ico('cart') %>
    <h2 class="h5">Giỏ hàng đang trống</h2>
    <p class="text-muted mb-3">Chọn vài sản phẩm ưng ý rồi quay lại đây nhé.</p>
    <a href="/products" class="btn btn-primary btn-lg">Tiếp tục mua sắm <%- ico('arrow') %></a>
  </div>
<% } else { %>
<div class="row g-4" id="cart-root" data-free-ship="5000000">
  <div class="col-lg-8">
    <label class="cart-selectall">
      <input type="checkbox" class="cart-check" data-select-all aria-label="Chọn tất cả sản phẩm có thể mua">
      <span>Chọn tất cả</span>
      <small class="text-muted">Sản phẩm không chọn sẽ ở lại trong giỏ để bạn mua sau.</small>
    </label>
    <ul class="cart-list list-unstyled" id="cart-list">
      <% items.forEach(function (i) {
           var maxQty = i.IsActive && i.QtyAvailable > 0 ? Math.min(99, i.QtyAvailable) : 99;
           var over = i.IsActive && i.Quantity > i.QtyAvailable;
           var canBuy = i.IsActive && i.QtyAvailable > 0; %>
        <li class="cart-line <%= !i.IsActive || i.QtyAvailable <= 0 ? 'is-unavailable' : '' %>" data-line data-product-id="<%= i.ProductId %>" data-price="<%= i.SalePrice %>" data-max="<%= maxQty %>">
          <input type="checkbox" class="cart-check" name="productId" value="<%= i.ProductId %>" form="cart-select-form" data-select <%= selected.includes(i.ProductId) ? 'checked' : '' %> <%= canBuy ? '' : 'disabled' %> aria-label="Chọn mua <%= i.ProductName %>">
          <a class="cart-img" href="/products/<%= i.Slug %>">
            <img src="<%= productImage(i.PrimaryImage, i.CategorySlug) %>" data-fallback="<%= productImage(null, i.CategorySlug) %>" alt="<%= i.ProductName %>" referrerpolicy="no-referrer">
          </a>
          <div class="cart-info">
            <a href="/products/<%= i.Slug %>" class="cart-name"><%= i.ProductName %></a>
            <div class="cart-sku"><span class="part-no"><%= i.Sku %></span></div>
            <div class="cart-flags" data-flags>
              <% if (!i.IsActive) { %><span class="flag flag-muted">Ngừng bán</span>
              <% } else if (i.QtyAvailable <= 0) { %><span class="flag flag-muted">Tạm hết hàng</span>
              <% } else if (over) { %><span class="flag flag-warn">Chỉ còn <%= i.QtyAvailable %> sản phẩm</span><% } %>
            </div>
            <div class="cart-unit tabular-nums"><%= fmtMoney(i.SalePrice) %></div>
          </div>
          <form method="post" action="/cart/update" class="cart-qty" data-qty-form>
            <input type="hidden" name="productId" value="<%= i.ProductId %>">
            <div class="qty qty-sm" data-qty>
              <button type="button" class="qty-btn" data-step="-1" aria-label="Giảm số lượng <%= i.ProductName %>"><%- ico('minus') %></button>
              <label class="visually-hidden" for="qty-<%= i.ProductId %>">Số lượng <%= i.ProductName %></label>
              <input id="qty-<%= i.ProductId %>" type="number" name="qty" value="<%= i.Quantity %>" min="1" max="<%= maxQty %>" inputmode="numeric">
              <button type="button" class="qty-btn" data-step="1" aria-label="Tăng số lượng <%= i.ProductName %>"><%- ico('plus') %></button>
            </div>
            <noscript><button class="btn btn-sm btn-outline-secondary mt-1">Cập nhật</button></noscript>
          </form>
          <div class="cart-total tabular-nums" data-line-total><%= fmtMoney(i.Quantity * i.SalePrice) %></div>
          <form method="post" action="/cart/remove/<%= i.ProductId %>" class="cart-remove" data-remove-form>
            <button class="icon-btn icon-btn-danger" aria-label="Bỏ <%= i.ProductName %> khỏi giỏ" title="Bỏ khỏi giỏ"><%- ico('trash') %></button>
          </form>
        </li>
      <% }) %>
    </ul>
    <a href="/products" class="back-link"><%- ico('arrow', 'ico-flip') %> Tiếp tục mua sắm</a>
  </div>

  <div class="col-lg-4">
    <div class="summary-card" id="cart-summary">
      <h2 class="summary-title">Tóm tắt đơn hàng</h2>
      <div class="summary-row"><span>Đã chọn</span><strong class="tabular-nums"><span data-selected-count>0</span> sản phẩm</strong></div>
      <div class="summary-row"><span>Tạm tính</span><strong class="tabular-nums" data-subtotal><%= fmtMoney(subtotal) %></strong></div>
      <p class="summary-note mt-0"><%- ico('truck', 'ico-sm') %><span>Phí vận chuyển và VAT sẽ được tính ở bước thanh toán.</span></p>
      <div class="ship-progress" data-ship-progress>
        <div class="ship-progress-text" data-ship-text></div>
        <div class="ship-progress-bar"><span data-ship-bar></span></div>
      </div>
      <form method="post" action="/cart/checkout" id="cart-select-form">
        <button class="btn btn-primary btn-lg w-100 mt-3" data-checkout-btn>Mua hàng đã chọn <%- ico('arrow') %></button>
      </form>
      <% if (!currentUser) { %>
        <p class="summary-note"><%- ico('info', 'ico-sm') %><span>Không cần đăng nhập để đặt hàng. <a href="/auth/login">Đăng nhập</a> để lưu giỏ hàng và địa chỉ.</span></p>
      <% } %>
    </div>
  </div>
</div>
<% } %>
