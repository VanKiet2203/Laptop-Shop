<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="d-flex align-items-center justify-content-between mb-4">
      <h1 class="h4 mb-0"><i class="bi bi-person-circle text-primary me-2"></i>Hồ sơ cá nhân</h1>
      <a href="/account/addresses" class="btn btn-outline-primary btn-sm">
        <i class="bi bi-geo-alt me-1"></i>Sổ địa chỉ giao hàng
      </a>
    </div>

    <div class="card mb-4">
      <div class="card-header bg-white py-3">
        <h2 class="h6 mb-0 text-dark"><i class="bi bi-person-lines-fill me-2"></i>Thông tin tài khoản</h2>
      </div>
      <div class="card-body p-4">
        <form method="post" action="/account">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label fw-semibold" for="nameCustomer">Họ và tên <span class="text-danger">*</span></label>
              <input type="text" id="nameCustomer" name="nameCustomer" class="form-control" 
                     value="<%= customer ? customer.FullName : '' %>" required>
            </div>

            <div class="col-md-6">
              <label class="form-label fw-semibold" for="phone">Số điện thoại <span class="text-danger">*</span></label>
              <input type="tel" id="phone" name="phone" class="form-control" 
                     value="<%= customer ? customer.Phone : '' %>" required pattern="[0-9]{10,11}">
            </div>

            <div class="col-12">
              <label class="form-label fw-semibold" for="email">Địa chỉ Email <span class="text-danger">*</span></label>
              <input type="email" id="email" name="email" class="form-control" 
                     value="<%= customer ? customer.Email : '' %>" required>
            </div>

            <div class="col-12 mt-4">
              <button type="submit" class="btn btn-primary px-4 py-2">
                <i class="bi bi-check2-circle me-1"></i>Lưu thay đổi
              </button>
              <a href="/" class="btn btn-outline-secondary ms-2 py-2">Quay lại trang chủ</a>
            </div>
          </div>
        </form>
      </div>
    </div>

    <!-- Phím tắt liên kết nhanh -->
    <div class="row g-3">
      <div class="col-md-6">
        <div class="card p-3 h-100">
          <div class="d-flex align-items-center">
            <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3 me-3">
              <i class="bi bi-bag-check fs-4"></i>
            </div>
            <div>
              <h3 class="h6 mb-1">Đơn hàng của tôi</h3>
              <p class="text-muted small mb-2">Theo dõi tiến độ giao hàng & lịch sử mua</p>
              <a href="/orders" class="btn btn-sm btn-link p-0 text-decoration-none fw-semibold">Xem đơn hàng &rarr;</a>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-6">
        <div class="card p-3 h-100">
          <div class="d-flex align-items-center">
            <div class="rounded-circle bg-success bg-opacity-10 text-success p-3 me-3">
              <i class="bi bi-geo-alt fs-4"></i>
            </div>
            <div>
              <h3 class="h6 mb-1">Sổ địa chỉ nhận hàng</h3>
              <p class="text-muted small mb-2">Quản lý các địa chỉ giao nhận nhanh</p>
              <a href="/account/addresses" class="btn btn-sm btn-link p-0 text-decoration-none fw-semibold">Quản lý địa chỉ &rarr;</a>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

