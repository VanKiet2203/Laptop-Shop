<%
  var statusFilter = typeof status !== 'undefined' && status ? status : '';
  var tabs = [
    { v: '', label: 'Tất cả', icon: 'receipt' },
    { v: 'Pending', label: 'Đang kiểm tra hàng', icon: 'clock' },
    { v: 'Approved', label: 'Đã xác nhận', icon: 'checkcircle' },
    { v: 'Completed', label: 'Đã giao', icon: 'box' },
    { v: 'Cancelled', label: 'Đã huỷ', icon: 'x' }
  ];
%>
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
  <div>
    <h1 class="page-title mb-1"><span class="page-title-ico"><%- ico('receipt') %></span> Đơn hàng của tôi</h1>
    <p class="text-muted small mb-0">Theo dõi tiến độ các đơn bạn đã đặt</p>
  </div>
  <a href="/products" class="btn btn-outline-primary btn-sm"><%- ico('cartplus') %> Tiếp tục mua hàng</a>
</div>

<nav class="tab-bar" aria-label="Lọc đơn theo trạng thái">
  <% tabs.forEach(function (t) { %>
    <a class="tab-link <%= statusFilter === t.v ? 'is-active' : '' %>" href="/orders<%= t.v ? '?status=' + t.v : '' %>" <%= statusFilter === t.v ? 'aria-current=page' : '' %>><%- ico(t.icon, 'ico-sm') %> <%= t.label %></a>
  <% }) %>
</nav>

<% if (!orders || !orders.length) { %>
  <div class="empty-card">
    <%- ico('receipt') %>
    <h2 class="h5">Chưa có đơn hàng<%= statusFilter ? ' ở trạng thái này' : '' %></h2>
    <p class="text-muted mb-3">Các đơn bạn đặt sẽ xuất hiện ở đây để tiện theo dõi bảo hành và giao nhận.</p>
    <a href="/products" class="btn btn-primary">Khám phá sản phẩm</a>
  </div>
<% } else { %>
  <div class="order-cards">
    <% orders.forEach(function (o) {
         var st = ORDER_STATUS[o.Status] || { label: o.Status, cls: 'secondary' };
         var pay = PAYMENT_STATUS[o.PaymentStatus] || { label: o.PaymentStatus, cls: 'secondary' };
         var canCancel = o.Status === 'Pending' || (o.Status === 'Approved' && o.PaymentStatus !== 'Paid'); %>
      <article class="order-card">
        <img class="order-thumb" src="<%= productImage(o.FirstImage, '') %>" data-fallback="<%= productImage(null, '') %>" alt="" referrerpolicy="no-referrer">
        <div class="order-main">
          <div class="d-flex flex-wrap align-items-center gap-2">
            <a class="part-no part-no-lg text-decoration-none" href="/orders/<%= o.OrderId %>"><%= o.OrderNo %></a>
            <span class="status-pill status-<%= st.cls %>"><%= st.label %></span>
          </div>
          <div class="order-meta small text-muted">
            <span><%- ico('clock', 'ico-sm') %> <%= fmtDateTime(o.CreatedAt) %></span>
            <span><%- ico('box', 'ico-sm') %> <%= o.TotalQty %> sản phẩm</span>
            <span><%- ico('card', 'ico-sm') %> <%= PAYMENT_METHOD[o.PaymentMethod] || o.PaymentMethod %> · <span class="status-text-<%= pay.cls %>"><%= pay.label %></span></span>
          </div>
        </div>
        <div class="order-side">
          <div class="order-total tabular-nums"><%= fmtMoney(o.TotalAmount) %></div>
          <div class="d-flex gap-2 justify-content-end">
            <a href="/orders/<%= o.OrderId %>" class="btn btn-outline-primary btn-sm">Chi tiết</a>
            <% if (canCancel) { %>
              <form method="post" action="/orders/<%= o.OrderId %>/cancel" data-confirm="Bạn có chắc muốn huỷ đơn <%= o.OrderNo %> không?">
                <button type="submit" class="btn btn-outline-danger btn-sm">Huỷ đơn</button>
              </form>
            <% } %>
          </div>
        </div>
      </article>
    <% }) %>
  </div>
<% } %>
