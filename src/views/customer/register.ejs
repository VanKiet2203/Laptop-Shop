<div class="row justify-content-center">
  <div class="col-md-8 col-lg-6 col-xl-5">
    <div class="auth-card">
      <div class="text-center mb-4">
        <span class="auth-ico"><%- ico('userplus') %></span>
        <h1 class="h4 mb-1">Tạo tài khoản</h1>
        <p class="text-muted small mb-0">Chỉ cần vài thông tin. Số điện thoại và địa chỉ giao hàng sẽ điền sau, khi bạn đặt hàng.</p>
      </div>

      <% if (errors && errors.length) { %>
        <div class="alert alert-danger" role="alert">
          <ul class="mb-0 ps-3"><% errors.forEach(function (msg) { %><li><%= msg %></li><% }) %></ul>
        </div>
      <% } %>

      <a class="btn btn-google w-100" href="/auth/google"><%- ico('google') %> Đăng ký nhanh với Google</a>
      <div class="auth-or"><span>hoặc điền thông tin</span></div>

      <form method="post" action="/register">
        <div class="mb-3">
          <label class="form-label" for="reg-fullname">Họ và tên</label>
          <input id="reg-fullname" name="fullName" class="form-control" required autofocus autocomplete="name" maxlength="100" value="<%= old.fullName || '' %>">
        </div>
        <div class="row">
          <div class="col-sm-6 mb-3">
            <label class="form-label" for="reg-username">Tên đăng nhập</label>
            <input id="reg-username" name="username" class="form-control" required autocomplete="username" maxlength="50" value="<%= old.username || '' %>">
          </div>
          <div class="col-sm-6 mb-3">
            <label class="form-label" for="reg-email">Email <span class="text-muted fw-normal">(tuỳ chọn)</span></label>
            <input id="reg-email" name="email" type="email" class="form-control" autocomplete="email" maxlength="150" value="<%= old.email || '' %>">
          </div>
        </div>
        <div class="mb-3">
          <label class="form-label" for="reg-phone">Số điện thoại <span class="text-muted fw-normal">(tuỳ chọn — bắt buộc khi đặt hàng)</span></label>
          <input id="reg-phone" name="phone" type="tel" class="form-control" placeholder="09xxxxxxxx" autocomplete="tel" maxlength="15" value="<%= old.phone || '' %>">
        </div>
        <div class="row">
          <div class="col-sm-6 mb-3">
            <label class="form-label" for="reg-password">Mật khẩu</label>
            <input id="reg-password" name="password" type="password" class="form-control" required minlength="6" autocomplete="new-password">
          </div>
          <div class="col-sm-6 mb-3">
            <label class="form-label" for="reg-confirm">Nhập lại mật khẩu</label>
            <input id="reg-confirm" name="confirmPassword" type="password" class="form-control" required minlength="6" autocomplete="new-password">
          </div>
        </div>
        <button class="btn btn-primary w-100 py-2 mt-1">Đăng ký <%- ico('arrow') %></button>
      </form>
      <p class="text-center small mt-3 mb-0">Đã có tài khoản? <a href="/auth/login">Đăng nhập</a></p>
    </div>
  </div>
</div>
