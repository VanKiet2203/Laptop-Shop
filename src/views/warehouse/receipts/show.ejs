<%
  var st = RECEIPT_STATUS[receipt.Status];
  var can = function (p) { return currentUser.permissions.includes(p); };
  var isDraft = receipt.Status === 'Draft';
  var owed = Number(receipt.TotalAmount) - Number(receipt.PaidAmount);
  var overdue = receipt.Status === 'Posted' && owed > 0 && receipt.DueDate && new Date(receipt.DueDate) < new Date();
%>
<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
  <div>
    <a class="small text-muted text-decoration-none" href="/warehouse/receipts">&larr; Danh sách phiếu nhập</a>
    <h2 class="h4 mt-1 mb-1"><span class="part-no"><%= receipt.ReceiptNo %></span> <span class="badge text-bg-<%= st.cls %> ms-2"><%= st.label %></span></h2>
    <div class="small text-muted">Lập lúc <%= fmtDateTime(receipt.ReceiptDate) %> bởi <%= receipt.EmployeeName %> (<%= receipt.EmployeeCode %>)</div>
  </div>
  <a class="btn btn-outline-secondary" href="/warehouse/receipts/<%= receipt.ReceiptId %>/print" target="_blank" rel="noopener"><%- ico('doc') %> In phiếu</a>
</div>

<% if (isDraft) { %>
  <div class="alert alert-warning d-flex gap-2 align-items-start"><%- ico('alert') %>
    <div>Phiếu đang ở trạng thái <strong>Nháp</strong>: tồn kho chưa thay đổi. Kiểm tra số lượng, đơn giá, Serial rồi bấm <strong>Chốt phiếu</strong>. Phiếu đã chốt không thể sửa hay huỷ.</div>
  </div>
<% } %>

<div class="row g-4">
  <div class="col-12 col-xl-8">
    <div class="card mb-4">
      <div class="card-header bg-white fw-semibold">Hàng nhập</div>
      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead><tr><th>Sản phẩm</th><th class="text-end">Đơn giá</th><th class="text-end">SL</th><th class="text-end">Thành tiền</th></tr></thead>
          <tbody>
            <% receipt.lines.forEach(function (l) { %>
              <tr>
                <td>
                  <span class="part-no d-inline-block mb-1"><%= l.Sku %></span>
                  <div class="fw-semibold"><%= l.ProductName %></div>
                  <% if (l.serials.length) { %>
                    <details class="mt-1"><summary class="small text-muted"><%= l.serials.length %> số Serial</summary>
                      <div class="serial-box mt-1">
                        <% l.serials.forEach(function (s) { var ss = SERIAL_STATUS[s.Status] || { label: s.Status, cls: 'secondary' }; %>
                          <div class="d-flex justify-content-between gap-3 border-bottom py-1"><span><%= s.SerialNumber %></span><span class="badge text-bg-<%= ss.cls %>"><%= ss.label %></span></div>
                        <% }) %>
                      </div>
                    </details>
                  <% } else if (l.IsSerialTracked) { %><div class="small text-muted mt-1">Quản lý theo Serial</div><% } %>
                </td>
                <td class="text-end tabular-nums"><%= fmtMoney(l.UnitCost) %></td>
                <td class="text-end tabular-nums"><%= l.Quantity %></td>
                <td class="text-end tabular-nums"><%= fmtMoney(l.LineTotal) %></td>
              </tr>
            <% }) %>
          </tbody>
          <tfoot class="table-light"><tr class="fw-bold"><td colspan="3" class="text-end">Tổng tiền hàng</td><td class="text-end tabular-nums"><%= fmtMoney(receipt.computedTotal) %></td></tr></tfoot>
        </table>
      </div>
    </div>
  </div>

  <div class="col-12 col-xl-4">
    <% if (isDraft && (can('receipt.post') || can('receipt.create'))) { %>
      <div class="card mb-4">
        <div class="card-header bg-white fw-semibold">Xử lý phiếu</div>
        <div class="card-body d-grid gap-2">
          <% if (can('receipt.post')) { %>
            <form method="post" action="/warehouse/receipts/<%= receipt.ReceiptId %>/post" onsubmit="return confirm('Chốt phiếu nhập? Tồn kho, Serial và giá vốn sẽ được cập nhật và không thể hoàn tác.')">
              <button class="btn btn-primary w-100" type="submit"><%- ico('checkcircle') %> Chốt phiếu (nhập kho)</button>
            </form>
          <% } %>
          <% if (can('receipt.create')) { %>
            <form method="post" action="/warehouse/receipts/<%= receipt.ReceiptId %>/cancel" onsubmit="return confirm('Huỷ phiếu nháp này? Các Serial đã khai báo sẽ bị xoá.')">
              <button class="btn btn-outline-danger w-100" type="submit"><%- ico('x') %> Huỷ phiếu nháp</button>
            </form>
          <% } %>
        </div>
      </div>
    <% } %>
    <div class="card mb-4">
      <div class="card-header bg-white fw-semibold">Nhà cung cấp</div>
      <div class="card-body small">
        <div class="fw-semibold fs-6"><%= receipt.SupplierName %></div>
        <% if (receipt.TaxCode) { %><div>MST: <%= receipt.TaxCode %></div><% } %>
        <% if (receipt.SupplierPhone) { %><div><%- ico('phone', 'ico-sm') %> <%= receipt.SupplierPhone %></div><% } %>
        <% if (receipt.SupplierAddress) { %><div><%- ico('pin', 'ico-sm') %> <%= receipt.SupplierAddress %></div><% } %>
        <div class="text-muted mt-1">Hạn thanh toán: <%= receipt.PaymentTermDays %> ngày</div>
      </div>
    </div>
    <div class="card">
      <div class="card-header bg-white fw-semibold">Thanh toán công nợ</div>
      <div class="card-body small">
        <div class="d-flex justify-content-between"><span>Tổng tiền</span><strong class="tabular-nums"><%= fmtMoney(receipt.Status === 'Posted' ? receipt.TotalAmount : receipt.computedTotal) %></strong></div>
        <div class="d-flex justify-content-between"><span>Đã thanh toán</span><span class="tabular-nums"><%= fmtMoney(receipt.PaidAmount) %></span></div>
        <div class="d-flex justify-content-between"><span>Còn nợ</span><strong class="tabular-nums <%= owed > 0 && receipt.Status === 'Posted' ? 'text-danger' : '' %>"><%= fmtMoney(Math.max(0, owed)) %></strong></div>
        <% if (receipt.DueDate) { %><div class="mt-2 <%= overdue ? 'text-danger fw-semibold' : 'text-muted' %>">Hạn thanh toán: <%= fmtDate(receipt.DueDate) %><%= overdue ? ' (quá hạn)' : '' %></div><% } %>
        <% if (receipt.Note) { %><div class="mt-2 p-2 bg-light rounded">Ghi chú: <%= receipt.Note %></div><% } %>
      </div>
    </div>
  </div>
</div>
