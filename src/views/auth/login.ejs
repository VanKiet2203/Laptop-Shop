<div class="row justify-content-center">
  <div class="col-md-6 col-lg-5 col-xl-4">
    <div class="auth-card">
      <div class="text-center mb-4">
        <span class="auth-ico"><%- ico('logo') %></span>
        <h1 class="h4 mb-1">Đăng nhập</h1>
        <p class="text-muted small mb-0">Vào Laptop Shop để tiếp tục</p>
      </div>

      <% if (typeof googleEnabled !== 'undefined' && googleEnabled) { %>
        <a class="btn btn-google w-100" href="/auth/google"><%- ico('google') %> Tiếp tục với Google</a>
      <% } else { %>
        <a class="btn btn-google w-100" href="/auth/google" title="Cần cấu hình GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET trong .env"><%- ico('google') %> Tiếp tục với Google</a>
      <% } %>
      <div class="auth-or"><span>hoặc dùng tài khoản</span></div>

      <form method="post" action="/auth/login">
        <div class="mb-3">
          <label class="form-label" for="login-username">Tên đăng nhập hoặc email</label>
          <div class="field-icon"><%- ico('user') %><input id="login-username" name="username" class="form-control" required autofocus autocomplete="username" placeholder="vd: khach1"></div>
        </div>
        <div class="mb-3">
          <label class="form-label" for="login-password">Mật khẩu</label>
          <div class="field-icon"><%- ico('lock') %><input id="login-password" name="password" type="password" class="form-control" required autocomplete="current-password" placeholder="••••••••"></div>
          <div class="text-end mt-1"><a class="small" href="/auth/forgot">Quên mật khẩu?</a></div>
        </div>
        <button class="btn btn-primary w-100 py-2">Đăng nhập <%- ico('arrow') %></button>
      </form>
      <p class="text-center small mt-3 mb-1">Chưa có tài khoản? <a href="/register">Đăng ký</a></p>
      <p class="text-center small mb-0 text-muted">Hoặc <a href="/products">tiếp tục mua sắm</a> — đặt hàng không cần đăng nhập.</p>
    </div>
    <% if (typeof showDemo !== 'undefined' && showDemo) { %>
    <div class="info-box mt-3">
      <%- ico('info') %>
      <div><strong>Tài khoản thử nghiệm</strong> (mật khẩu <code>123456</code>):<br>
      <code>admin</code> · <code>sales1</code> · <code>kho1</code> · <code>khach1</code></div>
    </div>
    <% } %>
  </div>
</div>
