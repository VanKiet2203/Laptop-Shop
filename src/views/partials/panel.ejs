<!DOCTYPE html>
<html lang="vi">
<head><%- include('head') %></head>
<body class="panel panel-<%= panel.theme %>">
  <div class="d-flex">
    <aside class="sidebar d-flex flex-column p-3">
      <a class="sidebar-brand mb-3" href="<%= panel.home %>"><span class="brand-mark"><%- ico(panel.icon) %></span><span class="brand-text"><%= panel.name %></span><small class="d-block"><%= panel.subtitle %></small></a>
      <ul class="nav nav-pills flex-column mb-auto">
        <%
          // Chỉ MỘT mục được sáng: khớp chính xác, hoặc mục có href dài nhất là tiền tố của đường dẫn hiện tại
          // (tránh /staff/reports sáng cùng /staff/reports/products)
          var activeHref = '';
          panel.nav.forEach(function (n) {
            if (!n.href) return;
            var hit = currentPath === n.href || (n.href !== panel.home && currentPath.indexOf(n.href + '/') === 0);
            if (hit && n.href.length > activeHref.length) activeHref = n.href;
          });
        %>
        <% panel.nav.forEach(function (n) { if (n.perm && !(currentUser && currentUser.permissions.indexOf(n.perm) !== -1)) return; if (n.section) { %>
          <li class="sidebar-section"><%= n.section %></li>
        <% } else { var active = n.href === activeHref; %>
          <li class="nav-item"><a class="nav-link <%= active ? 'active' : '' %>" href="<%= n.href %>"><%- ico(n.icon) %><span><%= n.label %></span><% if (n.badge) { %><span class="nav-badge" id="<%= n.badge %>" hidden>0</span><% } %></a></li>
        <% } }) %>
      </ul>
      <hr>
      <div class="sidebar-user mb-2">
        <span class="avatar" aria-hidden="true"><%= currentUser ? String(currentUser.fullName || '?').trim().charAt(0).toUpperCase() : '?' %></span>
        <span class="text-truncate"><%= currentUser ? currentUser.fullName : '' %></span>
      </div>
      <a class="btn btn-sm btn-outline-light mb-1" href="/auth/password"><%- ico('lock') %> Đổi mật khẩu</a>
      <a class="btn btn-sm btn-outline-light mb-1" href="/" target="_blank" rel="noopener"><%- ico('store') %> Xem cửa hàng</a>
      <form action="/auth/logout" method="post"><button class="btn btn-sm btn-light w-100"><%- ico('logout') %> Đăng xuất</button></form>
    </aside>
    <div class="content flex-grow-1">
      <header class="topbar px-4 py-3 border-bottom bg-white"><h1 class="h4 m-0"><%= title %></h1></header>
      <main class="p-4">
        <%- include('flash') %>
        <%- body %>
      </main>
    </div>
  </div>
  <%- include('scripts') %>
  <% if (currentUser && currentUser.permissions.indexOf('chat.reply') !== -1) { %><script src="/js/chat-staff.js?v=<%= assetVersion %>"></script><% } %>
</body>
</html>
