<p class="text-muted">Mỗi tài khoản thuộc một vai trò, và vai trò quyết định các chức năng được dùng. Thay đổi phân quyền có hiệu lực ngay ở thao tác kế tiếp của người dùng, không cần đăng nhập lại.</p>
<div class="row g-3">
  <% roles.forEach(function (r) { var pct = totalPerms ? Math.round(r.PermCount * 100 / totalPerms) : 0; %>
    <div class="col-md-6 col-xl-3">
      <div class="card h-100">
        <div class="card-body d-flex flex-column">
          <div class="d-flex justify-content-between align-items-start mb-1">
            <h2 class="h5 mb-0"><%= r.RoleName %></h2><span class="part-no"><%= r.RoleCode %></span>
          </div>
          <p class="small text-muted flex-grow-1"><%= r.Description || '' %></p>
          <div class="d-flex justify-content-between small mb-1"><span><%- ico('users', 'ico-sm') %> <%= r.AccountCount %> tài khoản</span><span class="text-muted"><%= r.ActiveCount %> hoạt động</span></div>
          <div class="hbar-row"><span>Quyền được cấp</span><span class="tabular-nums fw-semibold"><%= r.PermCount %>/<%= totalPerms %></span></div>
          <div class="hbar-track mb-3"><span style="width: <%= pct %>%"></span></div>
          <a class="btn btn-outline-primary" href="/admin/roles/<%= r.RoleId %>/permissions"><%- ico('key') %> Phân quyền</a>
        </div>
      </div>
    </div>
  <% }) %>
</div>
