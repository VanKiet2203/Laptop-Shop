<%
  var CAT_ICON = { laptop: 'laptop', 'laptop-gaming': 'bolt', 'laptop-van-phong': 'bag', 'laptop-do-hoa': 'sparkle', ram: 'ram', ssd: 'ssd',
                   chuot: 'mouse', 'ban-phim': 'keyboard', 'tai-nghe': 'headset', balo: 'bag', 'sac-cap': 'plug', 'linh-kien': 'cpu', 'phu-kien': 'gift' };
  var quickCats = [
    { slug: 'laptop', name: 'Laptop' },
    { slug: 'ram', name: 'RAM' }, { slug: 'ssd', name: 'Ổ cứng SSD' }, { slug: 'chuot', name: 'Chuột' },
    { slug: 'ban-phim', name: 'Bàn phím' }, { slug: 'tai-nghe', name: 'Tai nghe' }, { slug: 'balo', name: 'Balo - Túi' }, { slug: 'sac-cap', name: 'Sạc - Cáp' }
  ];
%>

<!-- Poster khuyến mãi (carousel) -->
<section class="poster carousel mb-4" id="poster" data-bs-ride="carousel" data-bs-interval="6500" aria-label="Chương trình khuyến mãi">
  <div class="carousel-indicators poster-dots">
    <button type="button" data-bs-target="#poster" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Back to School"></button>
    <button type="button" data-bs-target="#poster" data-bs-slide-to="1" aria-label="Nâng cấp RAM SSD"></button>
    <button type="button" data-bs-target="#poster" data-bs-slide-to="2" aria-label="Laptop gaming"></button>
  </div>
  <div class="carousel-inner">
    <!-- 1. Back to School -->
    <div class="carousel-item active">
      <div class="slide slide-bts">
        <div class="slide-copy">
          <span class="slide-eyebrow"><%- ico('sparkle') %> Mùa tựu trường 2026</span>
          <h1 class="slide-title">Back to <em>School</em></h1>
          <p class="slide-sub">Laptop học tập, đồ hoạ và linh kiện giảm đến <strong>8%</strong> — nhập mã tại bước thanh toán.</p>
          <ul class="slide-offers">
            <li><%- ico('percent') %> Mã <strong class="part-no part-no-light">BTS2026</strong> giảm 8% (tối đa 1,5 triệu) cho đơn từ 3 triệu</li>
            <li><%- ico('card') %> Trả góp 0% qua thẻ tín dụng, kỳ hạn 6–12 tháng</li>
            <li><%- ico('truck') %> Miễn phí giao hàng cho đơn từ 5 triệu</li>
          </ul>
          <div class="d-flex flex-wrap gap-2">
            <a href="/category/laptop-van-phong" class="btn btn-warning btn-lg">Chọn laptop học tập <%- ico('arrow') %></a>
            <a href="/products" class="btn btn-outline-light btn-lg">Xem tất cả</a>
          </div>
        </div>
        <img class="slide-art" src="/images/banner/bts.svg" alt="Laptop, balo, vở và bút chì cho mùa tựu trường" width="560" height="420">
      </div>
    </div>
    <!-- 2. Nâng cấp RAM / SSD -->
    <div class="carousel-item">
      <div class="slide slide-upgrade">
        <div class="slide-copy">
          <span class="slide-eyebrow"><%- ico('cpu') %> Nâng cấp máy cũ</span>
          <h2 class="slide-title">RAM &amp; SSD <em>đúng chuẩn</em></h2>
          <p class="slide-sub">Mỗi laptop đều gợi ý sẵn linh kiện tương thích (DDR4/DDR5, M.2 NVMe) để bạn không mua nhầm.</p>
          <ul class="slide-offers">
            <li><%- ico('shieldcheck') %> RAM, SSD bảo hành 36 tháng theo Serial</li>
            <li><%- ico('check') %> Kiểm tra tương thích ngay trên trang chi tiết laptop</li>
          </ul>
          <a href="/category/linh-kien" class="btn btn-warning btn-lg">Xem linh kiện <%- ico('arrow') %></a>
        </div>
        <img class="slide-art" src="/images/banner/upgrade.svg" alt="RAM và SSD NVMe" width="560" height="420" loading="lazy">
      </div>
    </div>
    <!-- 3. Laptop gaming -->
    <div class="carousel-item">
      <div class="slide slide-gaming">
        <div class="slide-copy">
          <span class="slide-eyebrow"><%- ico('flame') %> Gaming Week</span>
          <h2 class="slide-title">Laptop <em>Gaming</em> chiến mọi tựa game</h2>
          <p class="slide-sub">RTX 40-series, màn 144Hz trở lên, từ các hãng Asus, MSI, Lenovo, Acer.</p>
          <ul class="slide-offers">
            <li><%- ico('bolt') %> Sẵn hàng, xác nhận đơn nhanh với đơn 1 sản phẩm</li>
            <li><%- ico('gift') %> Chuột, bàn phím, tai nghe gaming giá tốt</li>
          </ul>
          <a href="/category/laptop-gaming" class="btn btn-warning btn-lg">Khám phá laptop gaming <%- ico('arrow') %></a>
        </div>
        <img class="slide-art" src="/images/banner/gaming.svg" alt="Laptop gaming RGB và chuột gaming" width="560" height="420" loading="lazy">
      </div>
    </div>
  </div>
  <button class="carousel-control-prev poster-ctrl" type="button" data-bs-target="#poster" data-bs-slide="prev" aria-label="Poster trước"><%- ico('chevright', 'ico-flip') %></button>
  <button class="carousel-control-next poster-ctrl" type="button" data-bs-target="#poster" data-bs-slide="next" aria-label="Poster sau"><%- ico('chevright') %></button>
</section>

<!-- Mã giảm giá đang chạy -->
<% if (promotions && promotions.length) { %>
<section class="mb-4" aria-label="Mã khuyến mãi">
  <div class="coupons">
    <% promotions.forEach(function (c) { %>
      <div class="coupon">
        <div class="coupon-main">
          <span class="coupon-ico"><%- ico('percent') %></span>
          <div>
            <div class="coupon-title"><%= c.DiscountType === 'Percent' ? 'Giảm ' + Number(c.DiscountValue) + '%' : 'Giảm ' + fmtMoneyShort(c.DiscountValue) %><%= c.MaxDiscount ? ' (tối đa ' + fmtMoneyShort(c.MaxDiscount) + ')' : '' %></div>
            <div class="coupon-desc"><%= c.MinOrderAmount > 0 ? 'Đơn từ ' + fmtMoneyShort(c.MinOrderAmount) : 'Mọi đơn hàng' %> · HSD <%= fmtDate(c.EndDate) %></div>
          </div>
        </div>
        <button type="button" class="coupon-code" data-copy="<%= c.Code %>" aria-label="Sao chép mã <%= c.Code %>">
          <span class="part-no"><%= c.Code %></span><%- ico('copy') %>
        </button>
      </div>
    <% }) %>
  </div>
</section>
<% } %>

<!-- Danh mục nhanh -->
<section class="mb-5" aria-label="Danh mục sản phẩm">
  <div class="cat-tiles">
    <% quickCats.forEach(function (c) { %>
      <a class="cat-tile" href="/category/<%= c.slug %>">
        <span class="cat-tile-ico"><%- ico(CAT_ICON[c.slug] || 'laptop') %></span>
        <span class="cat-tile-name"><%= c.name %></span>
      </a>
    <% }) %>
  </div>
</section>

<!-- Bán chạy nhất -->
<section class="mb-5">
  <div class="section-head">
    <h2 class="section-title"><span class="section-ico"><%- ico('flame') %></span> Bán chạy nhất</h2>
    <a class="section-more" href="/products">Xem tất cả <%- ico('arrow', 'ico-sm') %></a>
  </div>
  <div class="pgrid">
    <% bestSellers.forEach(function (p, i) { %><%- include('../partials/product-card', { p: p, rank: i < 3 ? i + 1 : null }) %><% }) %>
  </div>
</section>

<% if (gaming.length) { %>
<section class="mb-5">
  <div class="section-head">
    <h2 class="section-title"><span class="section-ico"><%- ico('bolt') %></span> Laptop Gaming</h2>
    <a class="section-more" href="/category/laptop-gaming">Xem thêm <%- ico('arrow', 'ico-sm') %></a>
  </div>
  <div class="pgrid"><% gaming.forEach(function (p) { %><%- include('../partials/product-card', { p: p }) %><% }) %></div>
</section>
<% } %>

<% if (office.length) { %>
<section class="mb-5">
  <div class="section-head">
    <h2 class="section-title"><span class="section-ico"><%- ico('bag') %></span> Laptop Văn phòng &amp; Học tập</h2>
    <a class="section-more" href="/category/laptop-van-phong">Xem thêm <%- ico('arrow', 'ico-sm') %></a>
  </div>
  <div class="pgrid"><% office.forEach(function (p) { %><%- include('../partials/product-card', { p: p }) %><% }) %></div>
</section>
<% } %>

<% if (upgrade.length) { %>
<section class="mb-5">
  <div class="upgrade-band">
    <div class="upgrade-copy">
      <span class="section-ico"><%- ico('cpu') %></span>
      <h2 class="h4 mb-1">Nâng cấp máy chỉ với RAM &amp; SSD</h2>
      <p class="mb-3">Chọn linh kiện đúng chuẩn DDR4/DDR5, M.2 NVMe — máy cũ chạy nhanh như mới.</p>
      <a href="/category/linh-kien" class="btn btn-light">Xem linh kiện <%- ico('arrow') %></a>
    </div>
    <div class="pgrid pgrid-tight"><% upgrade.forEach(function (p) { %><%- include('../partials/product-card', { p: p }) %><% }) %></div>
  </div>
</section>
<% } %>

<!-- Thương hiệu -->
<section class="mb-5">
  <div class="section-head"><h2 class="section-title"><span class="section-ico"><%- ico('tag') %></span> Thương hiệu</h2></div>
  <div class="brand-row">
    <% brands.forEach(function (b) { %>
      <a class="brand-pill" href="/products?brandId=<%= b.BrandId %>"><%= b.BrandName %> <small><%= b.count %></small></a>
    <% }) %>
  </div>
</section>

<section class="mb-4">
  <div class="section-head">
    <h2 class="section-title"><span class="section-ico"><%- ico('sparkle') %></span> Sản phẩm mới về</h2>
    <a class="section-more" href="/products?sort=newest">Xem tất cả <%- ico('arrow', 'ico-sm') %></a>
  </div>
  <div class="pgrid"><% products.forEach(function (p) { %><%- include('../partials/product-card', { p: p }) %><% }) %></div>
</section>
