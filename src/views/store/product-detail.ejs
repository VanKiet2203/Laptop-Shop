<%
  var inStock = product.QtyAvailable > 0;
  var lowStock = inStock && product.QtyAvailable <= 5;
  var fallbackImg = productImage(null, product.CategorySlug);
  var mainImg = productImage(images[0] && images[0].ImageUrl, product.CategorySlug);
  function attrIcon(name) {
    var n = String(name || '').toLowerCase();
    if (/ram|bộ nhớ/.test(n)) return 'ram';
    if (/ssd|ổ cứng|lưu trữ|hdd/.test(n)) return 'ssd';
    if (/cpu|vi xử lý|chip|gpu|card/.test(n)) return 'cpu';
    return null;
  }
%>
<nav aria-label="breadcrumb" class="mb-3">
  <ol class="breadcrumb small">
    <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
    <li class="breadcrumb-item"><a href="/category/<%= product.CategorySlug %>"><%= product.CategoryName %></a></li>
    <li class="breadcrumb-item active" aria-current="page"><%= product.ProductName %></li>
  </ol>
</nav>

<div class="row g-4 g-xl-5 pd">
  <div class="col-lg-6">
    <div class="pd-gallery">
      <div class="pd-stage">
        <span class="pd-corner pd-corner-tl" aria-hidden="true"></span><span class="pd-corner pd-corner-br" aria-hidden="true"></span>
        <% if (!inStock) { %><span class="pd-ribbon">Hết hàng</span><% } else if (lowStock) { %><span class="pd-ribbon pd-ribbon-warn">Sắp hết</span><% } %>
        <img id="pd-main" src="<%= mainImg %>" data-fallback="<%= fallbackImg %>" alt="<%= product.ProductName %>" referrerpolicy="no-referrer">
      </div>
      <% if (images.length > 1) { %>
      <div class="pd-thumbs" role="list">
        <% images.forEach(function (img, i) { %>
          <button type="button" class="pd-thumb <%= i === 0 ? 'is-active' : '' %>" role="listitem" data-src="<%= img.ImageUrl %>" aria-label="Xem ảnh <%= i + 1 %> của <%= images.length %>" aria-pressed="<%= i === 0 ? 'true' : 'false' %>">
            <img src="<%= img.ImageUrl %>" data-fallback="<%= fallbackImg %>" alt="" loading="lazy" referrerpolicy="no-referrer">
          </button>
        <% }) %>
      </div>
      <% } %>
    </div>
  </div>

  <div class="col-lg-6">
    <div class="pd-info">
      <div class="pd-meta"><span class="pd-brand"><%= product.BrandName %></span><span class="part-no"><%= product.Sku %></span></div>
      <span hidden data-chat-product="<%= product.ProductId %>" data-chat-name="<%= product.ProductName %>"></span>
<h1 class="pd-title"><%= product.ProductName %></h1>
      <% if (product.ShortDesc) { %><p class="pd-short"><%= product.ShortDesc %></p><% } %>

      <div class="pd-price-box">
        <div>
          <div class="pd-price-label">Giá bán</div>
          <div class="pd-price tabular-nums"><%= fmtMoney(product.SalePrice) %></div>
        </div>
        <% if (inStock) { %>
          <span class="stock-pill <%= lowStock ? 'is-low' : 'is-ok' %>"><span class="stock-dot" aria-hidden="true"></span><%= lowStock ? 'Chỉ còn ' : 'Còn ' %><%= product.QtyAvailable %> sản phẩm</span>
        <% } else { %>
          <span class="stock-pill is-out"><span class="stock-dot" aria-hidden="true"></span>Hết hàng</span>
        <% } %>
      </div>

      <ul class="pd-trust list-unstyled">
        <li><span class="pd-trust-ico"><%- ico('shieldcheck') %></span><div><strong>Bảo hành <%= product.WarrantyMonths %> tháng</strong><span>Tra cứu theo số Serial</span></div></li>
        <% if (product.IsSerialTracked) { %>
        <li><span class="pd-trust-ico"><%- ico('scan') %></span><div><strong>Theo dõi Serial/IMEI</strong><span>Mỗi máy một mã định danh</span></div></li>
        <% } %>
        <li><span class="pd-trust-ico"><%- ico('box') %></span><div><strong><%= inStock ? 'Sẵn hàng trong kho' : 'Tạm hết hàng' %></strong><span><%= inStock ? 'Đặt là có thể xử lý ngay' : 'Vui lòng quay lại sau' %></span></div></li>
      </ul>

      <%# Khách chưa đăng nhập vẫn thêm giỏ & đặt hàng được; chỉ tài khoản nhân viên/admin không mua hàng %>
      <% if (!currentUser || currentUser.role === 'CUSTOMER') { %>
        <form method="post" action="/cart/add" class="pd-buy" data-add-form>
          <input type="hidden" name="productId" value="<%= product.ProductId %>">
          <div class="qty" data-qty>
            <button type="button" class="qty-btn" data-step="-1" aria-label="Giảm số lượng" <%= inStock ? '' : 'disabled' %>><%- ico('minus') %></button>
            <label class="visually-hidden" for="pd-qty">Số lượng</label>
            <input id="pd-qty" type="number" name="qty" value="1" min="1" max="<%= inStock ? Math.min(99, product.QtyAvailable) : 99 %>" inputmode="numeric" <%= inStock ? '' : 'disabled' %>>
            <button type="button" class="qty-btn" data-step="1" aria-label="Tăng số lượng" <%= inStock ? '' : 'disabled' %>><%- ico('plus') %></button>
          </div>
          <button class="btn btn-primary btn-buy" <%= inStock ? '' : 'disabled' %>><%- ico('cartplus') %> Thêm vào giỏ</button>
        </form>
        <p class="pd-guest-note"><%- ico('info', 'ico-sm') %><span>Không cần đăng nhập — bạn chỉ cần điền họ tên, số điện thoại và địa chỉ ở bước chốt đơn.</span></p>
      <% } %>
    </div>
  </div>
</div>

<% if (attributes.length) { %>
<section class="pd-section" aria-labelledby="spec-heading">
  <h2 id="spec-heading" class="pd-h2">Thông số kỹ thuật</h2>
  <dl class="spec-grid">
    <% attributes.forEach(function (a) { var ic = attrIcon(a.AttrName); %>
      <div class="spec-item">
        <dt><% if (ic) { %><%- ico(ic) %><% } %><%= a.AttrName %></dt>
        <dd><%= a.AttrValue %><%= a.Unit ? ' ' + a.Unit : '' %></dd>
      </div>
    <% }) %>
  </dl>
</section>
<% } %>

<% if (compatibilityGroups.length) { %>
<section class="pd-section" aria-labelledby="compatible-components-heading">
  <div class="mb-3">
    <h2 id="compatible-components-heading" class="pd-h2 mb-1">Linh kiện tương thích</h2>
    <p class="small text-muted mb-0">Gợi ý theo chuẩn RAM/SSD và khả năng nâng cấp của sản phẩm.</p>
  </div>

  <% compatibilityGroups.forEach(function (group) { %>
  <div class="mb-4">
    <h3 class="h6 mb-2 d-flex align-items-center gap-2"><span class="pd-chip"></span><%= group.categoryName %></h3>
    <div class="pgrid pgrid-tight">
      <% group.products.forEach(function (component) { %><%- include('../partials/product-card', { p: component }) %><% }) %>
    </div>
  </div>
  <% }) %>
</section>
<% } %>
