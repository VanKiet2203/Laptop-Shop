
<h2>Thống kê doanh thu</h2>

<form method="GET" action="/staff/reports">
  <label for="from">Từ ngày:</label>
  <input
    type="date"
    id="from"
    name="from"
    value="<%= from %>"
    required
  >

  <label for="to">Đến ngày:</label>
  <input
    type="date"
    id="to"
    name="to"
    value="<%= to %>"
    required
  >

  <label for="group">Nhóm theo:</label>
  <select id="group" name="group">
    <option value="day" <%= group === 'day' ? 'selected' : '' %>>
      Ngày
    </option>
    <option value="month" <%= group === 'month' ? 'selected' : '' %>>
      Tháng
    </option>
    <option value="year" <%= group === 'year' ? 'selected' : '' %>>
      Năm
    </option>
  </select>

  <button type="submit">Thống kê</button>
</form>

<hr>

<h3>Thống kê trong tháng hiện tại</h3>

<p>
  Tổng doanh thu:
  <strong>
    <%= Number(cards.TotalRevenue || 0).toLocaleString('vi-VN') %> VNĐ
  </strong>
</p>

<p>
  Tổng số đơn:
  <strong>
    <%= Number(cards.TotalOrders || 0).toLocaleString('vi-VN') %>
  </strong>
</p>

<p>
  Tổng tiền trước giảm giá:
  <strong>
    <%= Number(cards.TotalGrossAmount || 0).toLocaleString('vi-VN') %> VNĐ
  </strong>
</p>

<p>
  Tổng tiền giảm giá:
  <strong>
    <%= Number(cards.TotalDiscountAmount || 0).toLocaleString('vi-VN') %> VNĐ
  </strong>
</p>

<p>
  Tổng VAT:
  <strong>
    <%= Number(cards.TotalVatAmount || 0).toLocaleString('vi-VN') %> VNĐ
  </strong>
</p>

<hr>

<h3>Chi tiết doanh thu</h3>

<table border="1" cellpadding="8" cellspacing="0" width="100%">
  <thead>
    <tr>
      <th>Thời gian</th>
      <th>Số đơn</th>
      <th>Doanh thu</th>
      <th>Trước giảm giá</th>
      <th>Giảm giá</th>
      <th>VAT</th>
    </tr>
  </thead>

  <tbody>
    <% if (report.rows.length === 0) { %>
      <tr>
        <td colspan="6">Không có dữ liệu trong khoảng thời gian này.</td>
      </tr>
    <% } else { %>
      <% report.rows.forEach(function(row) { %>
        <tr>
          <td><%= row.period %></td>
          <td><%= Number(row.orderCount || 0).toLocaleString('vi-VN') %></td>
          <td><%= Number(row.revenue || 0).toLocaleString('vi-VN') %> VNĐ</td>
          <td><%= Number(row.grossAmount || 0).toLocaleString('vi-VN') %> VNĐ</td>
          <td><%= Number(row.discountAmount || 0).toLocaleString('vi-VN') %> VNĐ</td>
          <td><%= Number(row.vatAmount || 0).toLocaleString('vi-VN') %> VNĐ</td>
        </tr>
      <% }); %>
    <% } %>
  </tbody>
</table>
