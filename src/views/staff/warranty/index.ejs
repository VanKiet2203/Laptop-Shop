
<div class="container mt-4">
  <h2>Tra cứu bảo hành</h2>
  <p class="text-muted">
    Tra cứu thông tin bảo hành theo số serial hoặc số điện thoại khách hàng.
  </p>

  <form action="/staff/warranty" method="GET" class="card p-3 mb-4">
    <div class="row g-3">
      <div class="col-md-5">
        <label for="serial" class="form-label">Số serial</label>
        <input
          type="text"
          id="serial"
          name="serial"
          class="form-control"
          placeholder="Nhập số serial"
          value="<%= serial || '' %>"
        >
      </div>

      <div class="col-md-5">
        <label for="phone" class="form-label">Số điện thoại khách hàng</label>
        <input
          type="text"
          id="phone"
          name="phone"
          class="form-control"
          placeholder="Nhập số điện thoại"
          value="<%= phone || '' %>"
        >
      </div>

      <div class="col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-primary w-100">
          Tra cứu
        </button>
      </div>
    </div>
  </form>

  <% if (serial || phone) { %>
    <% if (warranties && warranties.length > 0) { %>
      <div class="table-responsive">
        <table class="table table-bordered table-striped">
          <thead class="table-dark">
            <tr>
              <th>Khách hàng</th>
              <th>Số điện thoại</th>
              <th>Sản phẩm</th>
              <th>Serial</th>
              <th>Mã đơn hàng</th>
              <th>Ngày mua</th>
              <th>Bắt đầu bảo hành</th>
              <th>Hết hạn bảo hành</th>
              <th>Trạng thái</th>
            </tr>
          </thead>

          <tbody>
            <% warranties.forEach(function(item) { %>
              <tr>
                <td><%= item.CustomerName || '' %></td>
                <td><%= item.Phone || '' %></td>
                <td><%= item.ProductName || '' %></td>
                <td><%= item.SerialNumber || '' %></td>
                <td><%= item.OrderNo || '' %></td>
                <td>
                  <%= item.PurchaseDate
                    ? new Date(item.PurchaseDate).toLocaleDateString('vi-VN')
                    : '' %>
                </td>
                <td>
                  <%= item.StartDate
                    ? new Date(item.StartDate).toLocaleDateString('vi-VN')
                    : '' %>
                </td>
                <td>
                  <%= item.EndDate
                    ? new Date(item.EndDate).toLocaleDateString('vi-VN')
                    : '' %>
                </td>
                <td><%= item.WarrantyStatus || '' %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="alert alert-warning">
        Không tìm thấy thông tin bảo hành phù hợp.
      </div>
    <% } %>
  <% } %>
</div>
