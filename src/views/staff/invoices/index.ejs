
<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2>Quản lý hóa đơn</h2>
      <p class="text-muted mb-0">Tra cứu và xem hóa đơn bán hàng</p>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-body">
      <form method="GET" action="/staff/invoices"
            class="row g-3 align-items-end">

        <div class="col-md-3">
          <label for="from" class="form-label">Từ ngày</label>
          <input type="date" id="from" name="from"
                 class="form-control"
                 value="<%= filters.from %>">
        </div>

        <div class="col-md-3">
          <label for="to" class="form-label">Đến ngày</label>
          <input type="date" id="to" name="to"
                 class="form-control"
                 value="<%= filters.to %>">
        </div>

        <div class="col-md-4">
          <label for="q" class="form-label">Tìm hóa đơn</label>
          <input type="text" id="q" name="q"
                 class="form-control"
                 placeholder="Số hóa đơn, tên người mua..."
                 value="<%= filters.q %>">
        </div>

        <div class="col-md-2 d-flex gap-2">
          <button type="submit" class="btn btn-primary">
            Tìm kiếm
          </button>
          <a href="/staff/invoices" class="btn btn-secondary">
            Xóa lọc
          </a>
        </div>
      </form>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-body">
      <h5 class="text-muted">Tổng tiền hóa đơn trong kết quả</h5>
      <h3 class="text-success">
        <%= Number(totalAmount || 0).toLocaleString('vi-VN') %> ₫
      </h3>
      <p class="mb-0">Số hóa đơn: <strong><%= invoices.length %></strong></p>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <h5 class="mb-0">Danh sách hóa đơn</h5>
    </div>

    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
          <thead class="table-light">
            <tr>
              <th>Số hóa đơn</th>
              <th>Mã đơn hàng</th>
              <th>Ngày lập</th>
              <th>Người mua</th>
              <th>Tổng tiền</th>
              <th>Số lần in</th>
              <th>Thao tác</th>
            </tr>
          </thead>

          <tbody>
            <% if (invoices.length === 0) { %>
              <tr>
                <td colspan="7" class="text-center text-muted py-4">
                  Không tìm thấy hóa đơn phù hợp.
                </td>
              </tr>
            <% } else { %>
              <% invoices.forEach(invoice => { %>
                <tr>
                  <td><%= invoice.InvoiceNo %></td>
                  <td>#<%= invoice.OrderId %></td>
                  <td>
                    <%= invoice.IssuedAt
                      ? new Date(invoice.IssuedAt).toLocaleString('vi-VN')
                      : '' %>
                  </td>
                  <td>
                    <%= invoice.BuyerName || invoice.BuyerCompany || 'Khách lẻ' %>
                  </td>
                  <td class="text-end">
                    <%= Number(invoice.TotalAmount || 0).toLocaleString('vi-VN') %> ₫
                  </td>
                  <td class="text-center"><%= invoice.PrintCount || 0 %></td>
                  <td>
                    <a href="/staff/invoices/<%= invoice.InvoiceId %>"
                       class="btn btn-sm btn-info">
                      Chi tiết
                    </a>
                    <a href="/staff/invoices/<%= invoice.InvoiceId %>/print"
                       class="btn btn-sm btn-primary"
                       target="_blank">
                      In
                    </a>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
