<!DOCTYPE html>
<html lang="vi">
<head>
  <%- include('../../partials/head') %>
  <style>
    body { background: #fff; color: #111; }
    .sheet { max-width: 800px; margin: 1.5rem auto; padding: 0 1rem; }
    .sheet h1 { font-size: 1.6rem; text-align: center; letter-spacing: .05em; margin: .5rem 0 .15rem; }
    .sheet table { width: 100%; border-collapse: collapse; margin-top: 1rem; }
    .sheet th, .sheet td { border: 1px solid #999; padding: .4rem .55rem; vertical-align: top; }
    .sheet th { background: #f1f1f1; }
    .sheet .num { text-align: right; font-variant-numeric: tabular-nums; }
    .sign { display: grid; grid-template-columns: repeat(2, 1fr); text-align: center; margin-top: 2.5rem; }
    .sign div { min-height: 5.5rem; }
    .serials { font-family: ui-monospace, Consolas, monospace; font-size: .8rem; color: #333; word-break: break-all; }
    @media print { .no-print { display: none !important; } .sheet { margin: 0; max-width: none; } }
  </style>
</head>
<body>
  <div class="sheet">
    <div class="no-print text-end mb-3"><button class="btn btn-primary" onclick="window.print()">In hoá đơn</button></div>
    <div class="small">
      <strong><%= site.legalName %></strong><br>MST: <%= site.taxCode %><br><%= site.headOffice %><br>Điện thoại: <%= site.hotline %> · <%= site.email %>
    </div>
    <h1>HOÁ ĐƠN BÁN HÀNG</h1>
    <p class="text-center small mb-3">Số: <strong><%= invoice.InvoiceNo %></strong> · Ngày <%= fmtDate(invoice.IssuedAt) %> · Đơn hàng <%= invoice.OrderNo %></p>
    <p class="mb-1">Người mua: <strong><%= invoice.BuyerName %></strong></p>
    <% if (invoice.BuyerCompany) { %><p class="mb-1">Đơn vị: <%= invoice.BuyerCompany %><% if (invoice.BuyerTaxCode) { %> — MST <%= invoice.BuyerTaxCode %><% } %></p><% } %>
    <p class="mb-1">Địa chỉ: <%= invoice.BuyerAddress %></p>
    <p class="mb-1">Hình thức thanh toán: <%= PAYMENT_METHOD[invoice.PaymentMethod] || invoice.PaymentMethod %></p>
    <table>
      <thead><tr><th style="width:2.5rem">STT</th><th>Tên hàng hoá / Serial</th><th class="num">SL</th><th class="num">Đơn giá</th><th class="num">Thành tiền</th></tr></thead>
      <tbody>
        <% invoice.items.forEach(function (l, i) { %>
          <tr><td class="num"><%= i + 1 %></td>
            <td><strong><%= l.ProductName %></strong> <span class="text-muted">(<%= l.Sku %>)</span>
              <% if (l.Serials) { %><div class="serials">Serial: <%= l.Serials %></div><% } %>
              <div class="small text-muted">Bảo hành <%= l.WarrantyMonths %> tháng</div></td>
            <td class="num"><%= l.Quantity %></td><td class="num"><%= fmtMoney(l.UnitPrice) %></td><td class="num"><%= fmtMoney(l.LineTotal) %></td></tr>
        <% }) %>
        <tr><td colspan="4" class="num">Cộng tiền hàng</td><td class="num"><%= fmtMoney(invoice.SubtotalAmount) %></td></tr>
        <% if (Number(invoice.DiscountAmount) > 0) { %><tr><td colspan="4" class="num">Giảm giá</td><td class="num">-<%= fmtMoney(invoice.DiscountAmount) %></td></tr><% } %>
        <tr><td colspan="4" class="num">Thuế GTGT (<%= Number(invoice.VatRate) %>%)</td><td class="num"><%= fmtMoney(invoice.VatAmount) %></td></tr>
        <% if (Number(invoice.ShippingFee) > 0) { %><tr><td colspan="4" class="num">Phí giao hàng</td><td class="num"><%= fmtMoney(invoice.ShippingFee) %></td></tr><% } %>
        <tr><td colspan="4" class="num"><strong>Tổng thanh toán</strong></td><td class="num"><strong><%= fmtMoney(invoice.TotalAmount) %></strong></td></tr>
      </tbody>
    </table>
    <p class="small text-muted mt-2">Hoá đơn lập bởi <%= invoice.IssuedBy %> (<%= invoice.EmployeeCode %>) · in lần thứ <%= invoice.PrintCount %>. Giữ hoá đơn và số Serial để được bảo hành.</p>
    <div class="sign"><div><strong>Người mua hàng</strong><br><small>(Ký, ghi rõ họ tên)</small></div><div><strong>Người bán hàng</strong><br><small>(Ký, ghi rõ họ tên)</small></div></div>
  </div>
</body>
</html>
