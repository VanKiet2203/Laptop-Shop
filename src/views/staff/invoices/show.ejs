
<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2>Chi tiết hóa đơn</h2>
      <p class="text-muted mb-0">
        Số hóa đơn: <strong><%= invoice.InvoiceNo %></strong>
      </p>
    </div>

    <div class="d-flex gap-2">
      <a href="/staff/invoices/<%= invoice.InvoiceId %>/print"
         target="_blank" class="btn btn-primary">
        In hóa đơn
      </a>
      <a href="/staff/invoices" class="btn btn-secondary">
        Quay lại
      </a>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-header">
      <h5 class="mb-0">Thông tin hóa đơn</h5>
    </div>

    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-6">
          <strong>Mã đơn hàng:</strong>
          #<%= invoice.OrderId %>
        </div>

        <div class="col-md-6">
          <strong>Ngày lập:</strong>
          <%= invoice.IssuedAt
            ? new Date(invoice.IssuedAt).toLocaleString('vi-VN')
            : '' %>
        </div>

        <div class="col-md-6">
          <strong>Người mua:</strong>
          <%= invoice.BuyerName || 'Khách lẻ' %>
        </div>

        <div class="col-md-6">
          <strong>Công ty:</strong>
          <%= invoice.BuyerCompany || 'Không có' %>
        </div>

        <div class="col-md-6">
          <strong>Mã số thuế:</strong>
          <%= invoice.BuyerTaxCode || 'Không có' %>
        </div>

        <div class="col-md-6">
          <strong>Địa chỉ:</strong>
          <%= invoice.BuyerAddress || invoice.ShippingAddress || 'Không có' %>
        </div>

        <div class="col-md-6">
          <strong>Số điện thoại:</strong>
          <%= invoice.CustomerPhone || invoice.ReceiverPhone || 'Không có' %>
        </div>

        <div class="col-md-6">
          <strong>Trạng thái:</strong>
          <%= invoice.Status || 'Không có' %>
        </div>
      </div>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-header">
      <h5 class="mb-0">Danh sách sản phẩm</h5>
    </div>

    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
          <thead class="table-light">
            <tr>
              <th>STT</th>
              <th>Mã sản phẩm</th>
              <th>Tên sản phẩm</th>
              <th>Số lượng</th>
              <th>Đơn giá</th>
              <th>Bảo hành</th>
              <th>Serial</th>
              <th>Thành tiền</th>
            </tr>
          </thead>

          <tbody>
            <% if (!details || details.length === 0) { %>
              <tr>
                <td colspan="8" class="text-center text-muted">
                  Không có sản phẩm trong hóa đơn.
                </td>
              </tr>
            <% } else { %>
              <% details.forEach((item, index) => { %>
                <tr>
                  <td><%= index + 1 %></td>
                  <td><%= item.Sku %></td>
                  <td><%= item.ProductName %></td>
                  <td class="text-center"><%= item.Quantity %></td>
                  <td class="text-end">
                    <%= Number(item.UnitPrice || 0).toLocaleString('vi-VN') %> ₫
                  </td>
                  <td><%= item.WarrantyMonths || 0 %> tháng</td>
                  <td><%= item.Serials || 'Không có' %></td>
                  <td class="text-end">
                    <%= Number(item.LineTotal || 0).toLocaleString('vi-VN') %> ₫
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-body">
      <div class="row justify-content-end">
        <div class="col-md-5">
          <div class="d-flex justify-content-between mb-2">
            <span>Tiền hàng:</span>
            <strong>
              <%= Number(invoice.SubtotalAmount || 0).toLocaleString('vi-VN') %> ₫
            </strong>
          </div>

          <div class="d-flex justify-content-between mb-2">
            <span>Giảm giá:</span>
            <strong>
              <%= Number(invoice.DiscountAmount || 0).toLocaleString('vi-VN') %> ₫
            </strong>
          </div>

          <div class="d-flex justify-content-between mb-2">
            <span>Thuế VAT:</span>
            <strong>
              <%= Number(invoice.VatAmount || 0).toLocaleString('vi-VN') %> ₫
            </strong>
          </div>

          <hr>

          <div class="d-flex justify-content-between">
            <span class="fw-bold">Tổng thanh toán:</span>
            <strong class="text-success fs-5">
              <%= Number(invoice.TotalAmount || 0).toLocaleString('vi-VN') %> ₫
            </strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
