



<h1>Quản lý đơn hàng</h1>

<p>Đây là trang quản lý đơn hàng của nhân viên bán hàng.</p>

<form method="GET" action="/staff/orders">
  <label for="q">Mã đơn hàng, tên khách hàng hoặc số điện thoại:</label>
  <input
    type="text"
    id="q"
    name="q"
    value="<%= filters.q %>"
    placeholder="Nhập thông tin tìm kiếm"
  >

  <label for="status">Trạng thái:</label>
  <select id="status" name="status">
    <option value="">Tất cả</option>
    <option value="Pending" <%= filters.status === 'Pending' ? 'selected' : '' %>>Chờ duyệt</option>
    <option value="Approved" <%= filters.status === 'Approved' ? 'selected' : '' %>>Đã duyệt</option>
    <option value="Completed" <%= filters.status === 'Completed' ? 'selected' : '' %>>Hoàn tất</option>
    <option value="Cancelled" <%= filters.status === 'Cancelled' ? 'selected' : '' %>>Đã hủy</option>
  </select>

  <label for="from">Từ ngày:</label>
  <input type="date" id="from" name="from" value="<%= filters.from %>">

  <label for="to">Đến ngày:</label>
  <input type="date" id="to" name="to" value="<%= filters.to %>">

  <button type="submit">Tìm kiếm</button>
  <a href="/staff/orders">Xóa bộ lọc</a>
</form>

<p>Tổng số đơn hàng: <strong><%= total %></strong></p>

<table border="1" cellpadding="8" cellspacing="0">
  <thead>
    <tr>
      <th>Mã đơn</th>
      <th>Khách hàng</th>
      <th>Số điện thoại</th>
      <th>Ngày tạo</th>
      <th>Thanh toán</th>
      <th>Trạng thái</th>
      <th>Tổng tiền</th>
      <th>Chi tiết</th>
    </tr>
  </thead>

  <tbody>
    <% if (orders.length === 0) { %>
      <tr>
        <td colspan="8">Không tìm thấy đơn hàng.</td>
      </tr>
    <% } %>

    <% orders.forEach(order => { %>
      <tr>
        <td><%= order.OrderNo %></td>
        <td><%= order.CustomerName || 'Khách hàng' %></td>
        <td><%= order.CustomerPhone || '-' %></td>
        <td><%= order.CreatedAt ? new Date(order.CreatedAt).toLocaleString('vi-VN') : '-' %></td>
        <td><%= order.PaymentStatus || '-' %> (<%= order.PaymentMethod || '-' %>)</td>
        <td><%= order.Status %></td>
        <td><%= Number(order.TotalAmount || 0).toLocaleString('vi-VN') %> đ</td>
        <td>
          <a href="/staff/orders/<%= order.OrderId %>">Xem chi tiết</a>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>

